{
    "name": "imrandevbd/laravel-attendance-hub",
    "description": "Attendance hub bridge (L13 compatibility bridge until upstream supports Laravel 13)",
    "type": "library",
    "version": "dev-main",
    "license": "MIT",
    "authors": [{"name": "Imran Ahmed", "email": "me@imrandev.bd", "homepage": "https://imrandev.bd"}],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "ImranDevBd\\AttendanceHub\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["ImranDevBd\\AttendanceHub\\ServiceProvider"]
        }
    },
    "minimum-stability": "dev"
}
